# ─────────────────────────────────────────────
# DevGrasp Server — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────

# Server
PORT=5001

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API key
# Get it from: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (optional, needed for private repos + PR features)
# Create at: https://github.com/settings/tokens (need repo, read:org scopes)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Shared API secret between client and server (used to reject unknown clients)
# Use any long random string — must match VITE_API_SECRET in client/.env
API_SECRET=your_shared_api_secret_here

# Sentry DSN for error monitoring (optional but recommended for production)
# Get it from: https://sentry.io → Create Project → Node.js
SENTRY_DSN=https://your_key@sentry.io/your_project_id
